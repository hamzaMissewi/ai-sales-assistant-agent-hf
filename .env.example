# Primary LLM (OpenAI-compatible provider). Swap these 3 lines to change.
# Groq:    https://api.groq.com/openai/v1            model: openai/gpt-oss-120b | llama-3.1-8b-instant (free, highest request limits)
# Gemini:  https://generativelanguage.googleapis.com/v1beta/openai/   model: gemini-2.5-flash
# Mistral: https://api.mistral.ai/v1                 model: mistral-small-latest
# Ollama (local, fully free): http://localhost:11434/v1   model: qwen2.5:7b  (key: ollama)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_key_here
LLM_MODEL=llama-3.1-8b-instant

# Optional fallback LLM used automatically when the primary hits rate limits / errors.
# Gemini free key from https://aistudio.google.com/apikey (no card required).
FALLBACK_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=gemini-2.5-flash
